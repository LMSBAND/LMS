filename:0,shakebot_logo.png

import lms_core.jsfx-inc

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R

slider1:-12<-24,24,0.1>-Input Level (dB)
slider2:50<0,100,0.1>-Gain (%)
slider3:0<0,1,1{Twin Reverb (85W),Deluxe Reverb (22W)}>-Channel
slider4:50<0,100,1>-Bass (%)
slider5:50<0,100,1>-Mid (%)
slider6:50<0,100,1>-Treble (%)
slider7:50<0,100,1>-Presence (%)
slider8:50<0,100,1>-Master (%)
slider9:50<0,100,1>-Input Stage (%)
slider10:50<0,100,1>-PSU Sag (%)
slider11:-12<-24,24,0.1>-Output Level (dB)
slider12:0<0,1,1{Off,On}>-FX Bypass
// --- SPRING REVERB ---
slider13:0<0,100,1>-Spring Reverb (%)
// slider14 removed (dwell)
// --- TREMOLO ---
slider15:0<0,100,1>-Tremolo Depth (%)
slider16:50<0,100,1>-Tremolo Speed (%)
// --- TAPE ECHO ---
slider17:0<0,100,1>-Tape Echo Mix (%)
slider18:40<0,100,1>-Echo Feedback (%)
slider25:50<0,100,1>-Echo Time (%)
// --- CABINET ---
slider19:4<0,11,1{Off,1x12 Greenback,1x12 Jensen,1x12 Blue,2x12 Jensen,4x12 G12T-75,4x12 V30,8x10 Sealed,4x12 Sheffield,1x15 Open,4x10 Sealed,4x12 Closed}>-Cabinet
slider20:1<0,1,1{Off,On}>-Cab Sim
slider21:0<0,100,1>-Mic Distance (%)
// --- CABINET B ---
slider22:0<0,11,1{Off,1x12 Greenback,1x12 Jensen,1x12 Blue,2x12 Jensen,4x12 G12T-75,4x12 V30,8x10 Sealed,4x12 Sheffield,1x15 Open,4x10 Sealed,4x12 Closed}>-Cabinet B
slider23:0<0,100,1>-Mic B Distance (%)
// --- IMPEDANCE TAP ---
slider26:100<0,100,1>-Speaker Breakup (%)
slider24:0<0,2,1{4 ohm,8 ohm,16 ohm}>-Impedance Tap

@init


function twin_poweramp_set(drive, presence) local(pres_freq, pres_db, pres_q) (
  this.drive = drive;
  // Presence in NFB loop: resonant peak (Fender-style)
  pres_freq = 2500 + presence * 5000;
  pres_db = presence * 8;
  pres_q = 1.0 + presence * 1.0;
  this.pres_f.lms_bq_set_peak(pres_freq, pres_db * 2, pres_q);
);
function deluxe_poweramp_set(drive, presence) local(pres_freq, pres_db, pres_q) (
  this.drive = drive;
  pres_freq = 2000 + presence * 5000;
  pres_db = presence * 8;
  pres_q = 0.9 + presence * 0.9;
  this.pres_f.lms_bq_set_peak(pres_freq, pres_db * 2, pres_q);
);
// === INSTANCES ===
inp.lms_input_stage_init(5000, 0.55, 1200, -1.5, 0.030);
input_hp.lms_bq_init();
input_hp.lms_bq_set_hp(35, 0.7);  // AB763 input coupling: 0.1uF × 1M = ~1.6Hz (practically DC)

// RF filter — 68k grid stopper (same as Champ, common Fender design)
rf_filter.lms_bq_init();
rf_filter.lms_bq_set_lp(10000, 0.5);

// Bright cap on Normal channel — gain-dependent treble boost
// AB763: 120pF across 1M gain pot. At low gain: treble bypasses.
bright_cap.lms_bq_init();
bright_cap.lms_bq_set_hishelf(3500, 0.0, 0.7);

// V1a: 12AX7 input gain stage — fully bypassed cathode (25uF/1.5k)
// AB763 V1a: 0.1uF × 1M = ~1.6Hz coupling (we use 35Hz for safety).
// Miller LP at 8500Hz (bright Fender preamp — more HF than Marshall)
v1a.lms_triode_init(35, 8500, 4000, 250, 2000, 5000);

// Cathode follower (V1b) — unity-gain buffer before tone stack
cf.lms_cf_init(10, 0.070, 0.18, 15000);

// Phase inverter (12AT7 LTP) — LOWER gain than Marshall's 12AX7
// 12AT7: mu=60 (vs 12AX7 mu=100). More headroom at PI = cleaner power amp drive.
// This is why the Twin stays clean at volumes where a Marshall would break up.
// pos_hard/neg_hard softer, ceiling tighter.
pi.lms_triode_init(15, 9000, 4000, 250, 2000, 5000);  // wider bandwidth — Fender PI is bright

// Tone stack
ts.lms_tmb_init();
ts.lms_tmb_config(50,130, 18,0.55,  700, 0.8,1.5, 16, 1000,4000, 16,0.70,  2.0,1.5);
ts.lms_tmb_set(0.5, 0.5, 0.5);

// PSU
psu.lms_psu_init(0.0005, 0.040, 0.08, 0.70, 1.0);

// Twin power amp
twin_pa.lms_pp_pa_init(2.0, 1.6, 1.58, 0.85);
twin_pa.lms_pp_pa_cathode(0.003, 0.060, 0.08);
twin_pa.lms_pp_pa_xfmr(1.8, 0.982, 0.8, 0.15);
twin_pa.lms_pp_pa_xfmr_res(3800, 1.5, 2.0);
twin_pa.lms_pp_pa_nfb(5000, 600, 3000, 6000);
twin_pa.lms_pp_pa_hyst(0.08);
twin_pa.pres_f.lms_bq_init();
twin_pa.twin_poweramp_set(0.5, 0.5);

// Deluxe power amp
deluxe_pa.lms_pp_pa_init(2.5, 1.4, 1.35, 0.85);
deluxe_pa.lms_pp_pa_cathode(0.004, 0.120, 0.15);
deluxe_pa.lms_pp_pa_xfmr(3.0, 0.985, 1.2, 0.25);
deluxe_pa.lms_pp_pa_xfmr_res(3500, 2.0, 2.0);
deluxe_pa.lms_pp_pa_nfb(4500, 700, 2800, 5500);
deluxe_pa.lms_pp_pa_hyst(0.08);
deluxe_pa.pres_f.lms_bq_init();
deluxe_pa.deluxe_poweramp_set(0.5, 0.5);

// Soft gate
gate.lms_sgate_init(0.001, 0.0002);

// Spring reverb
spring.lms_spring_init();
// Fender 3-spring tank — brighter, longer tail
spring.fb_lp.lms_bq_set_lp(3000, 0.5);
spring.in_lp.lms_bq_set_lp(4500, 0.6);
spring.spring_coeff = 0.30;
spring.spring_wet = 0.35;

// Tremolo
trem.lms_trem_init();

// Tape echo
echo.lms_tape_echo_init();

// Cabinet simulation (shared presets from core)
lms_cab_table_init();
cab.lms_cab_init();
cab.lms_cab_set(4);  // default: 2x12 Jensen (Twin)
cab_type = 4;
cab_on = 1;
cab2.lms_cab_init();
cab2.lms_cab_set(0);
cab2_type = 0;
cab_dual = 0;
cab_b_solo = 0;

// Impedance interaction — Twin/Deluxe rear panel tap (4/8/16 ohm)
amp_designed_ohms = 4;  // default: 4 ohm tap
ohm_ratio = 1.0;
ohm_sag_mult = 1.0;
ohm_vol = 1.0;
ohm_lo_gain = 0;
ohm_lo.lms_bq_init();
cab_load_ohms = 4;

gain = 0.5; in_level = 1; out_level = 1; master = 0.5;
amp_channel = 0; input_intensity = 0.5; sag_depth = 0.5;
spring_mix = 0;
trem_depth = 0; trem_speed = 0.5;
echo_mix = 0; echo_time = 0.5; echo_feedback = 0.4;
fx_bypass = 0;
// Density matrix animation state (128 cells for 16x8 grid)
DM_CELLS = 90000;
memset(DM_CELLS, 0, 128);
dm_frame = 0;
d_env_lo = 0; d_env_mid = 0; d_env_hi = 0; d_env_air = 0;
d_density = 1.0; d_mid_d = 0; d_hi_d = 0; d_air_d = 0;
d_miller_freq = 8500; d_miller_q = 0.6; d_grid_cond = 0;
d_drive_boost = 1.0; d_bplus = 1.0;

  notice_show = 0;

@slider
in_level = 10 ^ (slider1 / 20);
gain = slider2 / 100;
bright_cap.lms_bq_set_hishelf(3500, (1.0 - gain) * (1.0 - gain) * 3.5, 0.7);
amp_channel = slider3;
amp_channel == 1 ? psu.lms_psu_init(0.004, 0.120, 0.18, 0.70, 1.0)  // Deluxe 5U4GB tube
                 : psu.lms_psu_init(0.0005, 0.040, 0.08, 0.70, 1.0); // Twin silicon
ts.lms_tmb_set(slider4/100, slider5/100, slider6/100);
master = slider8 / 100;
twin_pa.twin_poweramp_set(master, slider7/100);
deluxe_pa.deluxe_poweramp_set(master, slider7/100);
input_intensity = slider9 / 100;
sag_depth = slider10 / 100;
out_level = 10 ^ (slider11 / 20);
fx_bypass = slider12;
spring_mix = slider13 / 100;
trem_depth = slider15 / 100;
trem_speed = slider16 / 100;
echo_mix = slider17 / 100;
echo_time = slider25 / 100;
echo_feedback = slider18 / 100;
cab_type = slider19;
cab_on = slider20;
cab.lms_cab_set(cab_on ? cab_type : 0);
cab_mic = slider21;
cab.lms_cab_set_mic(cab_mic);
cab2_type = slider22;
cab2.lms_cab_set(cab_on ? cab2_type : 0);
cab2_mic = slider23;
cab2.lms_cab_set_mic(cab2_mic);
cab_dual = cab_on && cab_type > 0 && cab2_type > 0;
cab_b_solo = cab_on && cab_type == 0 && cab2_type > 0;
cab.cab_breakup_amt = slider26 / 100;
cab2.cab_breakup_amt = slider26 / 100;

// Impedance interaction — rear panel tap + load mismatch
amp_designed_ohms = slider24 == 0 ? 4 : slider24 == 1 ? 8 : 16;
cab_a_ohms = lms_cab_get_ohms(cab_on ? cab_type : 0);
cab_b_ohms = lms_cab_get_ohms(cab_on ? cab2_type : 0);
cab_load_ohms = lms_cab_compute_load(cab_a_ohms, cab_b_ohms);
cab_load_ohms > 0 ? (
  ohm_ratio = cab_load_ohms / amp_designed_ohms;
  ohm_ratio = max(0.25, min(4.0, ohm_ratio));
  ohm_sag_mult = 1.0 / ohm_ratio;
  ohm_sag_mult = max(0.5, min(2.5, ohm_sag_mult));
  ohm_vol = 1.0 / sqrt(ohm_ratio);
  ohm_vol = max(0.5, min(1.6, ohm_vol));
  ohm_lo_gain = (1.0 - ohm_ratio) * 3.0;
  ohm_lo_gain = max(-4.0, min(4.0, ohm_lo_gain));
  abs(ohm_lo_gain) > 0.2 ? (
    ohm_lo.lms_bq_set_loshelf(120, ohm_lo_gain, 0.7);
  ) : (
    ohm_lo.lms_bq_init();
  );
) : (
  ohm_sag_mult = 1.0;
  ohm_vol = 1.0;
  ohm_lo.lms_bq_init();
);

// ============================================================
// @BLOCK — Broadcast, heartbeat, stale-check, follow, steal
// ============================================================
@block
// ---- Recalculate from sliders (GFX changes don't trigger @slider) ----
in_level = 10 ^ (slider1 / 20);
gain = slider2 / 100;
bright_cap.lms_bq_set_hishelf(3500, (1.0 - gain) * (1.0 - gain) * 3.5, 0.7);
amp_channel = slider3;
amp_channel == 1 ? psu.lms_psu_init(0.004, 0.120, 0.18, 0.70, 1.0)  // Deluxe 5U4GB tube
                 : psu.lms_psu_init(0.0005, 0.040, 0.08, 0.70, 1.0); // Twin silicon
ts.lms_tmb_set(slider4/100, slider5/100, slider6/100);
master = slider8 / 100;
twin_pa.twin_poweramp_set(master, slider7/100);
deluxe_pa.deluxe_poweramp_set(master, slider7/100);
input_intensity = slider9 / 100;
sag_depth = slider10 / 100;
out_level = 10 ^ (slider11 / 20);
fx_bypass = slider12;
spring_mix = slider13 / 100;
trem_depth = slider15 / 100;
trem_speed = slider16 / 100;
echo_mix = slider17 / 100;
echo_time = slider25 / 100;
echo_feedback = slider18 / 100;
cab_type = slider19;
cab_on = slider20;
cab.lms_cab_set(cab_on ? cab_type : 0);
cab_mic = slider21;
cab.lms_cab_set_mic(cab_mic);
cab2_type = slider22;
cab2.lms_cab_set(cab_on ? cab2_type : 0);
cab2_mic = slider23;
cab2.lms_cab_set_mic(cab2_mic);
cab_dual = cab_on && cab_type > 0 && cab2_type > 0;
cab_b_solo = cab_on && cab_type == 0 && cab2_type > 0;
cab.cab_breakup_amt = slider26 / 100;
cab2.cab_breakup_amt = slider26 / 100;

// Impedance interaction — rear panel tap + load mismatch
amp_designed_ohms = slider24 == 0 ? 4 : slider24 == 1 ? 8 : 16;
cab_a_ohms = lms_cab_get_ohms(cab_on ? cab_type : 0);
cab_b_ohms = lms_cab_get_ohms(cab_on ? cab2_type : 0);
cab_load_ohms = lms_cab_compute_load(cab_a_ohms, cab_b_ohms);
cab_load_ohms > 0 ? (
  ohm_ratio = cab_load_ohms / amp_designed_ohms;
  ohm_ratio = max(0.25, min(4.0, ohm_ratio));
  ohm_sag_mult = 1.0 / ohm_ratio;
  ohm_sag_mult = max(0.5, min(2.5, ohm_sag_mult));
  ohm_vol = 1.0 / sqrt(ohm_ratio);
  ohm_vol = max(0.5, min(1.6, ohm_vol));
  ohm_lo_gain = (1.0 - ohm_ratio) * 3.0;
  ohm_lo_gain = max(-4.0, min(4.0, ohm_lo_gain));
  abs(ohm_lo_gain) > 0.2 ? (
    ohm_lo.lms_bq_set_loshelf(120, ohm_lo_gain, 0.7);
  ) : (
    ohm_lo.lms_bq_init();
  );
) : (
  ohm_sag_mult = 1.0;
  ohm_vol = 1.0;
  ohm_lo.lms_bq_init();
);


@sample

mono = (spl0 + spl1) * 0.5 * in_level;
// Input clamp — catches record-arm spikes before the amp sees them
mono = max(-1.0, min(1.0, mono));

// 0. RF filter (68k grid stopper — common Fender input circuit)
mono = rf_filter.lms_bq_proc(mono);

// 1. Input stage (grid physics — AB763 1M grid leak)
input_intensity > 0.0 ? (
  mono = inp.lms_input_stage_proc(mono, input_intensity);
);

// 2. Input coupling cap
mono = input_hp.lms_bq_proc(mono);

// 3. PSU sag (Twin=silicon tight, Deluxe=5U4GB moderate bloom)
bplus = psu.lms_psu_proc(abs(mono) * (1.0 + gain * 2.5), sag_depth * ohm_sag_mult);

// 4. Bright cap — gain-dependent (120pF across 1M pot)
// At low gain: +3.5dB at 3.5kHz. At high gain: swamped.
mono = bright_cap.lms_bq_proc(mono);

// 5. V1a (12AX7 — AB763 preamp, fully bypassed cathode = high gain)
// Fender V1a: softer positive clip (warm) with moderate negative clip.
// Less gain than Marshall V1a (Fender doesn't cascade as aggressively).
v1a_drive = gain * 0.55;
v1a_out = v1a.lms_triode_proc(mono, v1a_drive, bplus,
  1.3, 1.1, 0.85, 1.0, 0.35, 0.12);

// 6. Cathode follower (V1b) — unity-gain buffer before tone stack
// Prevents tone stack loading, adds gentle programme-dependent compression
amp_out = cf.lms_cf_proc(v1a_out, bplus);

// 7. Fender tone stack (AB763 — different from Marshall)
amp_out = ts.lms_tmb_proc(amp_out);
amp_out *= 1.0 + gain * 5.0;

// 8. Phase inverter (12AT7 LTP — LESS gain than Marshall's 12AX7 LTP)
// This is WHY the Twin stays clean longer: the PI barely distorts.
// 12AT7: pos_hard=0.7, neg_hard=0.65 (softer, earlier grid conduction)
// At high master, just a hint of rounding before the power tubes.
pi_drive = master * 0.30;  // less PI drive than Marshall (12AT7 = lower gain)
amp_out = pi.lms_triode_proc(amp_out, pi_drive, bplus,
  0.7, 0.65, 0.80, 0.85, 0.40, 0.08);

// 9. Effects loop (pre-power-amp — signal returns through power tubes + cab)
fx_bypass == 0 ? (
  // Tremolo (bias trem)
  trem_depth > 0 ? (
    amp_out = trem.lms_trem_proc(amp_out, trem_depth, trem_speed);
  );
  // Spring reverb (Fender 3-spring tank)
  spring_mix > 0 ? (
    amp_out = spring.lms_spring_proc(amp_out, spring_mix);
  );
  // Tape echo
  echo_mix > 0 ? (
    amp_out = echo.lms_tape_echo_proc(amp_out, echo_mix, echo_time, echo_feedback);
  );
  // Safety clamp — catches runaway feedback before it hits power tubes
  amp_out = max(-0.95, min(0.95, amp_out));
);

// 10. POWER AMP (channel-dependent: Twin 6L6 or Deluxe 6V6)
amp_out *= master;
amp_channel == 0 ? (
  // TWIN REVERB: 6L6GC push-pull (85W) — THE Fender clean
  amp_out = twin_pa.lms_pp_pa_proc(amp_out, bplus);

  amp_out = twin_pa.pres_f.lms_bq_proc(amp_out);
) : (
  // DELUXE REVERB: 6V6GT push-pull (22W) — breaks up beautifully
  amp_out = deluxe_pa.lms_pp_pa_proc(amp_out, bplus);

  amp_out = deluxe_pa.pres_f.lms_bq_proc(amp_out);
);

// 11. Soft gate
amp_out = gate.lms_sgate_proc(amp_out);

// Impedance interaction — power delivery + damping factor
amp_out *= ohm_vol;
amp_out = ohm_lo.lms_bq_proc(amp_out);

// 12. Cabinet (density-aware dual cab speaker sim)
cab_dual ? (
  cab_a_out = cab.lms_cab_proc(amp_out, v1a.hd.density);
  cab_b_out = cab2.lms_cab_proc(amp_out, v1a.hd.density);
  amp_out = (cab_a_out + cab_b_out) * 0.5;
) : cab_b_solo ? (
  amp_out = cab2.lms_cab_proc(amp_out, v1a.hd.density);
) : (
  amp_out = cab.lms_cab_proc(amp_out, v1a.hd.density);
);

amp_out *= out_level;
// Brickwall output limiter — transparent safety ceiling
amp_out = max(-0.95, min(0.95, amp_out));

spl0 = amp_out;
spl1 = amp_out;


// Density state for GFX — use v1a (primary preamp stage)
d_env_lo  = v1a.hd.env_lo;  d_env_mid = v1a.hd.env_mid;
d_env_hi  = v1a.hd.env_hi;  d_env_air = v1a.hd.env_air;
d_density = v1a.hd.density;
d_mid_d   = v1a.hd.mid_density;  d_hi_d = v1a.hd.hi_density;  d_air_d = v1a.hd.air_density;
d_miller_freq = v1a.last_miller_freq;  d_miller_q = v1a.last_miller_q;
d_drive_boost = 1.0 + v1a.hd.mid_density * 0.4;
d_grid_cond   = v1a.peak_env;
d_bplus = bplus;

@gfx 600 564

// ============================================================================
//  SCALING — compute scale factor from actual window size vs nominal
// ============================================================================
lms_gfx_setup(600);

// ============================================================================
//  BACKGROUND
// ============================================================================
hdr_h = floor(44 * S);
gfx_r = COL_BG_R; gfx_g = COL_BG_G; gfx_b = COL_BG_B;
gfx_rect(0, 0, gfx_w, gfx_h);
gfx_r = 0.03; gfx_g = 0.03; gfx_b = 0.05;
gfx_rect(0, 0, gfx_w, hdr_h);
gfx_r = COL_TITLE_R * 0.6; gfx_g = COL_TITLE_G * 0.6; gfx_b = COL_TITLE_B * 0.6;
gfx_rect(0, hdr_h, gfx_w, max(1, floor(2 * S)));

// ============================================================================
//  LAYOUT
// ============================================================================
margin = floor(8 * S);
gap = floor(6 * S);
bar_h = floor(18 * S);
bar_sp = floor(21 * S);
col_w = 190;
pad = floor(4 * S);
pad2 = pad * 2;
gr_bar_h = max(2, floor(6 * S));
body_y = floor(50 * S);

// ============================================================================
//  LOGO + TITLE
// ============================================================================
gfx_getimgdim(0, logo_img_w, logo_img_h);
logo_img_w > 0 ? (
  logo_h = floor(32 * S);
  logo_w = floor(logo_h * (logo_img_w / logo_img_h));
  logo_x = floor(6 * S);
  logo_y = floor(((hdr_h - logo_h)) / 2);
  gfx_blit(0, 1, 0, 0, 0, logo_img_w, logo_img_h, logo_x, logo_y, logo_w, logo_h);
) : (
  logo_w = 0;
  logo_x = 0;
);
gfx_r = COL_TITLE_R; gfx_g = COL_TITLE_G; gfx_b = COL_TITLE_B;
gfx_setfont(1, "Arial", F_TITLE);
gfx_x = logo_x + logo_w + floor(8 * S); gfx_y = floor(10 * S);
gfx_drawstr("THE TWINS v2");
gfx_r = COL_DIM_R; gfx_g = COL_DIM_G; gfx_b = COL_DIM_B;
gfx_setfont(1, "Arial", F_LABEL);
gfx_measurestr("Density-Aware Dual American Clean", sub_w, sub_h);
gfx_x = gfx_w - sub_w - floor(10 * S); gfx_y = floor(10 * S);
gfx_drawstr("Density-Aware Dual American Clean");

// ============================================================================
//  COL 1: PREAMP
// ============================================================================
c1x = margin;
lms_draw_panel(c1x, body_y, col_w, 26 + 5 * bar_sp, "PREAMP");
cy = body_y + floor(26 * S);
_old = slider1; slider1 = lms_draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider1, -24, 24, "Input dB", 1);
slider1 != _old ? slider_automate(2^0);
cy += bar_sp;
_old = slider2; slider2 = lms_draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider2, 0, 100, "Gain", 1);
slider2 != _old ? slider_automate(2^1);
cy += bar_sp;
strcpy(MS_BUF, "Twin (85W)"); strcpy(MS_BUF+1, "Deluxe (22W)");
_old = slider3; slider3 = lms_draw_mode_sel(c1x + pad, cy, col_w - pad2, bar_h, slider3, 1, "Channel");
slider3 != _old ? slider_automate(2^2);
cy += bar_sp;
_old = slider9; slider9 = lms_draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider9, 0, 100, "Input Stg", 1);
slider9 != _old ? slider_automate(2^8);
cy += bar_sp;
_old = slider10; slider10 = lms_draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider10, 0, 100, "PSU Sag", 1);
slider10 != _old ? slider_automate(2^9);

// ============================================================================
//  COL 2: TONE / POWER
// ============================================================================
c2x = margin + col_w + gap;
lms_draw_panel(c2x, body_y, col_w, 26 + 6 * bar_sp, "TONE / POWER");
cy = body_y + floor(26 * S);
_old = slider4; slider4 = lms_draw_bar(c2x + pad, cy, col_w - pad2, bar_h, slider4, 0, 100, "Bass", 1);
slider4 != _old ? slider_automate(2^3);
cy += bar_sp;
_old = slider5; slider5 = lms_draw_bar(c2x + pad, cy, col_w - pad2, bar_h, slider5, 0, 100, "Mid", 1);
slider5 != _old ? slider_automate(2^4);
cy += bar_sp;
_old = slider6; slider6 = lms_draw_bar(c2x + pad, cy, col_w - pad2, bar_h, slider6, 0, 100, "Treble", 1);
slider6 != _old ? slider_automate(2^5);
cy += bar_sp;
_old = slider7; slider7 = lms_draw_bar(c2x + pad, cy, col_w - pad2, bar_h, slider7, 0, 100, "Presence", 1);
slider7 != _old ? slider_automate(2^6);
cy += bar_sp;
_old = slider8; slider8 = lms_draw_bar(c2x + pad, cy, col_w - pad2, bar_h, slider8, 0, 100, "Master", 1);
slider8 != _old ? slider_automate(2^7);
cy += bar_sp;
_old = slider11; slider11 = lms_draw_bar(c2x + pad, cy, col_w - pad2, bar_h, slider11, -24, 24, "Output dB", 1);
slider11 != _old ? slider_automate(2^10);

// ============================================================================
//  COL 3: EFFECTS
// ============================================================================
c3x = margin + (col_w + gap) * 2;
lms_draw_panel(c3x, body_y, col_w, 26 + 10 * bar_sp, "EFFECTS");
cy = body_y + floor(26 * S);
_old = slider12; slider12 = lms_draw_toggle(c3x + pad, cy + 2, slider12, "FX Bypass");
slider12 != _old ? slider_automate(2^11);
cy += bar_sp;
_old = slider13; slider13 = lms_draw_bar(c3x + pad, cy, col_w - pad2, bar_h, slider13, 0, 100, "Reverb", 1);
slider13 != _old ? slider_automate(2^12);
cy += bar_sp;
_old = slider15; slider15 = lms_draw_bar(c3x + pad, cy, col_w - pad2, bar_h, slider15, 0, 100, "Trem Depth", 1);
slider15 != _old ? slider_automate(2^14);
cy += bar_sp;
_old = slider16; slider16 = lms_draw_bar(c3x + pad, cy, col_w - pad2, bar_h, slider16, 0, 100, "Trem Speed", 1);
slider16 != _old ? slider_automate(2^15);
cy += bar_sp;
_old = slider17; slider17 = lms_draw_bar(c3x + pad, cy, col_w - pad2, bar_h, slider17, 0, 100, "Echo Mix", 1);
slider17 != _old ? slider_automate(2^16);
cy += bar_sp;
_old = slider25; slider25 = lms_draw_bar(c3x + pad, cy, col_w - pad2, bar_h, slider25, 0, 100, "Echo Time", 1);
slider25 != _old ? slider_automate(2^24);
cy += bar_sp;
_old = slider18; slider18 = lms_draw_bar(c3x + pad, cy, col_w - pad2, bar_h, slider18, 0, 100, "Echo FB", 1);
slider18 != _old ? slider_automate(2^17);

// ============================================================================
//  CABINET PANEL (full width, between controls and density)
// ============================================================================
  p3h = 26 + 10 * bar_sp;  // EFFECTS is tallest
  cab_panel_y = body_y + p3h + gap;
  cab_panel_w = col_w * 3 + gap * 2;
  cab_panel_x = margin;
  cab_panel_h = floor(180 * S);
  lms_draw_panel(cab_panel_x, cab_panel_y, cab_panel_w, cab_panel_h, "CABINET");
  cab_cy = cab_panel_y + floor(26 * S);
  cab_cw = floor(cab_panel_w * 0.60);
  _old = slider19; slider19 = lms_draw_cab_sel(cab_panel_x + 4, cab_cy, cab_cw - 8, bar_h, slider19);
  slider19 != _old ? slider_automate(2^18);
  _old = slider20; slider20 = lms_draw_toggle(cab_panel_x + cab_cw + floor(8 * S), cab_cy, slider20, "Cab Sim");
  slider20 != _old ? slider_automate(2^19);
  _old = slider21; slider21 = lms_draw_bar(cab_panel_x + 4, cab_cy + bar_sp, cab_panel_w - 8, bar_h, slider21, 0, 100, "Mic A Distance", 1);
  slider21 != _old ? slider_automate(2^20);
  _old = slider22; slider22 = lms_draw_cab_sel_b(cab_panel_x + 4, cab_cy + bar_sp * 2, cab_cw - 8, bar_h, slider22);
  slider22 != _old ? slider_automate(2^21);
  _old = slider23; slider23 = lms_draw_bar(cab_panel_x + 4, cab_cy + bar_sp * 3, cab_panel_w - 8, bar_h, slider23, 0, 100, "Mic B Distance", 1);
  slider23 != _old ? slider_automate(2^22);
  _old = slider26; slider26 = lms_draw_bar(cab_panel_x + 4, cab_cy + bar_sp * 4, cab_panel_w - 8, bar_h, slider26, 0, 100, "Spkr Breakup", 1);
  slider26 != _old ? slider_automate(2^25);

  // Impedance tap selector (clickable) + readout
  gfx_setfont(1, "Arial", F_TINY);
  ohm_tap_y = cab_cy + bar_sp * 5 + floor(2 * S);
  ohm_tap_x = cab_panel_x + 4;
  ohm_tap_w = floor(70 * S);
  ohm_tap_h = floor(16 * S);
  gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.14;
  gfx_rect(ohm_tap_x, ohm_tap_y, ohm_tap_w, ohm_tap_h);
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(ohm_tap_x, ohm_tap_y, ohm_tap_w, 1);
  gfx_rect(ohm_tap_x, ohm_tap_y + ohm_tap_h - 1, ohm_tap_w, 1);
  gfx_rect(ohm_tap_x, ohm_tap_y, 1, ohm_tap_h);
  gfx_rect(ohm_tap_x + ohm_tap_w - 1, ohm_tap_y, 1, ohm_tap_h);
  gfx_r = COL_ACCENT_R; gfx_g = COL_ACCENT_G; gfx_b = COL_ACCENT_B;
  gfx_x = ohm_tap_x + floor(4 * S); gfx_y = ohm_tap_y + floor((ohm_tap_h - F_TINY) / 2);
  gfx_drawstr(sprintf(#, "Tap: %dR", amp_designed_ohms));
  (mouse_cap & 1) && !(last_cap & 1) &&
    mouse_x >= ohm_tap_x && mouse_x <= ohm_tap_x + ohm_tap_w &&
    mouse_y >= ohm_tap_y && mouse_y <= ohm_tap_y + ohm_tap_h ? (
      _old = slider24;
      slider24 = (slider24 + 1) % 3;
      slider24 != _old ? slider_automate(2^23);
  );
  cab_load_ohms > 0 ? (
    gfx_x = ohm_tap_x + ohm_tap_w + floor(8 * S); gfx_y = ohm_tap_y + floor((ohm_tap_h - F_TINY) / 2);
    ohm_ratio > 0.9 && ohm_ratio < 1.1 ? (
      gfx_r = 0.25; gfx_g = 0.80; gfx_b = 0.50;
    ) : ohm_ratio > 0.6 && ohm_ratio < 1.5 ? (
      gfx_r = 0.95; gfx_g = 0.78; gfx_b = 0.35;
    ) : (
      gfx_r = 0.95; gfx_g = 0.45; gfx_b = 0.15;
    );
    cab_load_ohms == floor(cab_load_ohms) ? (
      gfx_drawstr(sprintf(#, "Load: %dR", cab_load_ohms));
    ) : (
      gfx_drawstr(sprintf(#, "Load: %.1fR", cab_load_ohms));
    );
    ohm_ratio > 0.9 && ohm_ratio < 1.1 ? (
      gfx_r = 0.25; gfx_g = 0.80; gfx_b = 0.50;
      gfx_drawstr(" matched");
    );
  );

// ============================================================================
//  DENSITY AWARENESS PANEL
// ============================================================================
  dm_panel_y = cab_panel_y + cab_panel_h + gap;
  dm_panel_w = col_w * 3 + gap * 2;
  lms_dm_panel();
  gfx_r = COL_BAR_BG_R; gfx_g = COL_BAR_BG_G; gfx_b = COL_BAR_BG_B;
  gfx_rect(dm_mx, dm_my, dm_mw, dm_meter_h);
  dm_mfill = max(0, min(1, (d_miller_freq - 5000) / 3500));
  dm_mfill_w = dm_mfill * dm_mw;
  dm_mfill_w > 0 ? ( gfx_r = COL_CYAN_R * 0.6; gfx_g = COL_CYAN_G * 0.6; gfx_b = COL_CYAN_B * 0.6; gfx_rect(dm_mx, dm_my, dm_mfill_w, dm_meter_h); gfx_r = COL_CYAN_R; gfx_g = COL_CYAN_G; gfx_b = COL_CYAN_B; gfx_rect(dm_mx, dm_my, dm_mfill_w, 1); );
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(dm_mx, dm_my, dm_mw, 1); gfx_rect(dm_mx, dm_my + dm_meter_h - 1, dm_mw, 1);
  gfx_rect(dm_mx, dm_my, 1, dm_meter_h); gfx_rect(dm_mx + dm_mw - 1, dm_my, 1, dm_meter_h);
  gfx_r = COL_TEXT_R; gfx_g = COL_TEXT_G; gfx_b = COL_TEXT_B;
  gfx_setfont(1, "Arial", max(7, floor(9 * S)));
  gfx_x = dm_mx + floor(2 * S); gfx_y = dm_my + floor((dm_meter_h - floor(9 * S)) / 2);
  gfx_drawstr("MLR LP");
  dm_mx += dm_mw + dm_meter_gap;
  gfx_r = COL_BAR_BG_R; gfx_g = COL_BAR_BG_G; gfx_b = COL_BAR_BG_B;
  gfx_rect(dm_mx, dm_my, dm_mw, dm_meter_h);
  dm_mfill = max(0, min(1, (d_miller_q - 0.6) / 0.35));
  dm_mfill_w = dm_mfill * dm_mw;
  dm_mfill_w > 0 ? ( gfx_r = COL_CYAN_R * 0.6; gfx_g = COL_CYAN_G * 0.6; gfx_b = COL_CYAN_B * 0.6; gfx_rect(dm_mx, dm_my, dm_mfill_w, dm_meter_h); gfx_r = COL_CYAN_R; gfx_g = COL_CYAN_G; gfx_b = COL_CYAN_B; gfx_rect(dm_mx, dm_my, dm_mfill_w, 1); );
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(dm_mx, dm_my, dm_mw, 1); gfx_rect(dm_mx, dm_my + dm_meter_h - 1, dm_mw, 1);
  gfx_rect(dm_mx, dm_my, 1, dm_meter_h); gfx_rect(dm_mx + dm_mw - 1, dm_my, 1, dm_meter_h);
  gfx_r = COL_TEXT_R; gfx_g = COL_TEXT_G; gfx_b = COL_TEXT_B;
  gfx_setfont(1, "Arial", max(7, floor(9 * S)));
  gfx_x = dm_mx + floor(2 * S); gfx_y = dm_my + floor((dm_meter_h - floor(9 * S)) / 2);
  gfx_drawstr("MLR Q");
  dm_mx += dm_mw + dm_meter_gap;
  gfx_r = COL_BAR_BG_R; gfx_g = COL_BAR_BG_G; gfx_b = COL_BAR_BG_B;
  gfx_rect(dm_mx, dm_my, dm_mw, dm_meter_h);
  dm_mfill = max(0, min(1, d_grid_cond / 0.35));
  dm_mfill_w = dm_mfill * dm_mw;
  dm_mfill_w > 0 ? ( gfx_r = COL_CYAN_R * 0.6; gfx_g = COL_CYAN_G * 0.6; gfx_b = COL_CYAN_B * 0.6; gfx_rect(dm_mx, dm_my, dm_mfill_w, dm_meter_h); gfx_r = COL_CYAN_R; gfx_g = COL_CYAN_G; gfx_b = COL_CYAN_B; gfx_rect(dm_mx, dm_my, dm_mfill_w, 1); );
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(dm_mx, dm_my, dm_mw, 1); gfx_rect(dm_mx, dm_my + dm_meter_h - 1, dm_mw, 1);
  gfx_rect(dm_mx, dm_my, 1, dm_meter_h); gfx_rect(dm_mx + dm_mw - 1, dm_my, 1, dm_meter_h);
  gfx_r = COL_TEXT_R; gfx_g = COL_TEXT_G; gfx_b = COL_TEXT_B;
  gfx_setfont(1, "Arial", max(7, floor(9 * S)));
  gfx_x = dm_mx + floor(2 * S); gfx_y = dm_my + floor((dm_meter_h - floor(9 * S)) / 2);
  gfx_drawstr("GRID");
  dm_mx += dm_mw + dm_meter_gap;
  gfx_r = COL_BAR_BG_R; gfx_g = COL_BAR_BG_G; gfx_b = COL_BAR_BG_B;
  gfx_rect(dm_mx, dm_my, dm_mw, dm_meter_h);
  dm_mfill = max(0, min(1, (d_drive_boost - 1.0) / 0.4));
  dm_mfill_w = dm_mfill * dm_mw;
  dm_mfill_w > 0 ? ( gfx_r = COL_CYAN_R * 0.6; gfx_g = COL_CYAN_G * 0.6; gfx_b = COL_CYAN_B * 0.6; gfx_rect(dm_mx, dm_my, dm_mfill_w, dm_meter_h); gfx_r = COL_CYAN_R; gfx_g = COL_CYAN_G; gfx_b = COL_CYAN_B; gfx_rect(dm_mx, dm_my, dm_mfill_w, 1); );
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(dm_mx, dm_my, dm_mw, 1); gfx_rect(dm_mx, dm_my + dm_meter_h - 1, dm_mw, 1);
  gfx_rect(dm_mx, dm_my, 1, dm_meter_h); gfx_rect(dm_mx + dm_mw - 1, dm_my, 1, dm_meter_h);
  gfx_r = COL_TEXT_R; gfx_g = COL_TEXT_G; gfx_b = COL_TEXT_B;
  gfx_setfont(1, "Arial", max(7, floor(9 * S)));
  gfx_x = dm_mx + floor(2 * S); gfx_y = dm_my + floor((dm_meter_h - floor(9 * S)) / 2);
  gfx_drawstr("DRIVE");
  dm_mx += dm_mw + dm_meter_gap;
  gfx_r = COL_BAR_BG_R; gfx_g = COL_BAR_BG_G; gfx_b = COL_BAR_BG_B;
  gfx_rect(dm_mx, dm_my, dm_mw, dm_meter_h);
  dm_mfill = max(0, min(1, (d_bplus - 0.75) / 0.25));
  dm_mfill_w = dm_mfill * dm_mw;
  dm_mfill_w > 0 ? ( gfx_r = COL_CYAN_R * 0.6; gfx_g = COL_CYAN_G * 0.6; gfx_b = COL_CYAN_B * 0.6; gfx_rect(dm_mx, dm_my, dm_mfill_w, dm_meter_h); gfx_r = COL_CYAN_R; gfx_g = COL_CYAN_G; gfx_b = COL_CYAN_B; gfx_rect(dm_mx, dm_my, dm_mfill_w, 1); );
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(dm_mx, dm_my, dm_mw, 1); gfx_rect(dm_mx, dm_my + dm_meter_h - 1, dm_mw, 1);
  gfx_rect(dm_mx, dm_my, 1, dm_meter_h); gfx_rect(dm_mx + dm_mw - 1, dm_my, 1, dm_meter_h);
  gfx_r = COL_TEXT_R; gfx_g = COL_TEXT_G; gfx_b = COL_TEXT_B;
  gfx_setfont(1, "Arial", max(7, floor(9 * S)));
  gfx_x = dm_mx + floor(2 * S); gfx_y = dm_my + floor((dm_meter_h - floor(9 * S)) / 2);
  gfx_drawstr("B+");


  last_cap = mouse_cap;

  // --- BUY + NOTICE BUTTONS ---
  lms_gfx_chrome(gfx_h - floor(20 * S));

// ============================================================
// @SERIALIZE — Persist follow state
// ============================================================
@serialize
file_var(0, bc.bc_ser_compat_1);
file_var(0, bc.bc_ser_compat_2);
