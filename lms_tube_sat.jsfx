desc:LMS Tube Saturator
//tags: saturation distortion tube analog
//author: LMS
filename:0,shakebot_logo.png


import lms_core.jsfx-inc

slider1:0<0,100,0.1>-Drive (%)
slider2:0<-12,12,0.1>-Output Gain (dB)
slider3:100<0,100,1>-Dry/Wet (%)
slider4:0<0,100,0.1>-Even Harmonics (%)
slider5:50<0,100,0.1>-Odd Harmonics (%)
slider6:1<0,4,1{Warm Tube,Hot Tube,Tape,Rectifier,Fuzz}>-Mode
slider7:100<20,20000,1>-Tone (Hz)
slider8:0<0,100,0.1>-Bias (%)

@init
  // Initialize density-aware saturation (L/R independent state)
  sat_l.lms_sat_warm_init();
  sat_r.lms_sat_warm_init();
  harm_l.lms_sat_harmonics_init();
  harm_r.lms_sat_harmonics_init();
  dc.lms_dc_init_freq(220);
  tone.lms_tone_init();

notice_show = 0;


@slider
  drive = slider1 / 100;
  out_gain = 10 ^ (slider2 / 20);
  dry_wet = slider3 / 100;
  even_harm = slider4 / 100;
  odd_harm = slider5 / 100;
  mode = slider6;
  bias = slider8 / 100;

  // Tone filter
  tone.lms_tone_set(slider7);

// ============================================================
// @BLOCK — Broadcast, heartbeat, stale-check, follow, steal
// ============================================================
@block
// ---- Recalculate from sliders (GFX changes don't trigger @slider) ----
drive = slider1 / 100;
out_gain = 10 ^ (slider2 / 20);
dry_wet = slider3 / 100;
even_harm = slider4 / 100;
odd_harm = slider5 / 100;
mode = slider6;
bias = slider8 / 100;

// Tone filter
tone.lms_tone_set(slider7);


@sample
  dry_l = spl0;
  dry_r = spl1;

  l = spl0;
  r = spl1;

  // Apply density-aware saturation based on mode
  mode == 0 ? (
    l = sat_l.lms_sat_warm(l, drive, bias);
    r = sat_r.lms_sat_warm(r, drive, bias);
  ) : mode == 1 ? (
    l = sat_l.lms_sat_hot(l, drive, bias);
    r = sat_r.lms_sat_hot(r, drive, bias);
  ) : mode == 2 ? (
    l = sat_l.lms_sat_tape(l, drive, bias);
    r = sat_r.lms_sat_tape(r, drive, bias);
  ) : mode == 3 ? (
    l = sat_l.lms_sat_rect(l, drive, bias);
    r = sat_r.lms_sat_rect(r, drive, bias);
  ) : (
    l = sat_l.lms_sat_fuzz(l, drive, bias);
    r = sat_r.lms_sat_fuzz(r, drive, bias);
  );

  // Add harmonics
  (even_harm > 0 || odd_harm > 0) ? (
    l = harm_l.lms_sat_harmonics(l, even_harm, odd_harm);
    r = harm_r.lms_sat_harmonics(r, even_harm, odd_harm);
  );

  // Tone control
  l = tone.lms_tone_proc_l(l);
  r = tone.lms_tone_proc_r(r);

  // Output gain
  l *= out_gain;
  r *= out_gain;

  // DC blocker
  l = dc.lms_dc_proc_l(l);
  r = dc.lms_dc_proc_r(r);

  // Dry/wet mix
  spl0 = dry_l * (1 - dry_wet) + l * dry_wet;
  spl1 = dry_r * (1 - dry_wet) + r * dry_wet;

@gfx 520 330

// ============================================================================
//  SCALING — compute scale factor from actual window size vs nominal
// ============================================================================
lms_gfx_setup(520);
!(mouse_cap & 1) ? (cap_bx = -1; cap_by = -1);

// ============================================================================
//  BACKGROUND
// ============================================================================
hdr_h = floor(44 * S);
gfx_r = COL_BG_R; gfx_g = COL_BG_G; gfx_b = COL_BG_B;
gfx_rect(0, 0, gfx_w, gfx_h);
gfx_r = 0.03; gfx_g = 0.03; gfx_b = 0.05;
gfx_rect(0, 0, gfx_w, hdr_h);
gfx_r = COL_TITLE_R * 0.6; gfx_g = COL_TITLE_G * 0.6; gfx_b = COL_TITLE_B * 0.6;
gfx_rect(0, hdr_h, gfx_w, max(1, floor(2 * S)));

// ============================================================================
//  HELPER: draw_bar
// ============================================================================
function draw_bar(bx, by, bw, bh, val, vmin, vmax, label, show_val) (
  gfx_r = COL_BAR_BG_R; gfx_g = COL_BAR_BG_G; gfx_b = COL_BAR_BG_B;
  gfx_rect(bx, by, bw, bh);
  norm = (val - vmin) / (vmax - vmin);
  norm = max(0, min(1, norm));
  fill_w = norm * bw;
  fill_w > 0 ? (
    gfx_r = COL_CYAN_R * 0.6; gfx_g = COL_CYAN_G * 0.6; gfx_b = COL_CYAN_B * 0.6;
    gfx_rect(bx, by, fill_w, bh);
    gfx_r = COL_CYAN_R * 0.8; gfx_g = COL_CYAN_G * 0.8; gfx_b = COL_CYAN_B * 0.8;
    gfx_rect(bx, by, fill_w, floor(bh / 2));
    gfx_r = COL_CYAN_R; gfx_g = COL_CYAN_G; gfx_b = COL_CYAN_B;
    gfx_rect(bx, by, fill_w, 1);
  );
  gfx_r = COL_BORDER_R; gfx_g = COL_BORDER_G; gfx_b = COL_BORDER_B;
  gfx_rect(bx, by, bw, 1); gfx_rect(bx, by + bh - 1, bw, 1);
  gfx_rect(bx, by, 1, bh); gfx_rect(bx + bw - 1, by, 1, bh);
  gfx_r = COL_TEXT_R; gfx_g = COL_TEXT_G; gfx_b = COL_TEXT_B;
  gfx_setfont(1, "Arial", F_LABEL);
  gfx_x = bx + floor(5 * S); gfx_y = by + floor((bh - F_LABEL) / 2);
  gfx_drawstr(label);
  show_val ? (
    gfx_setfont(1, "Arial", F_SMALL);
    gfx_x = bx + bw - floor(40 * S); gfx_y = by + floor((bh - F_SMALL) / 2);
    gfx_drawnumber(val, val == floor(val) ? 0 : 1);
  );
  (mouse_cap & 1) && !(last_cap & 1) &&
    mouse_x >= bx && mouse_x <= bx + bw &&
    mouse_y >= by && mouse_y <= by + bh ? (
      cap_bx = bx; cap_by = by;
  );
  (mouse_cap & 1) && cap_bx == bx && cap_by == by ? (
    new_norm = (mouse_x - bx) / bw;
    new_norm = max(0, min(1, new_norm));
    val = vmin + new_norm * (vmax - vmin);
  );
  val;
);

// ============================================================================
//  HELPER: draw_panel
// ============================================================================
// ============================================================================
//  HELPER: draw_toggle (not currently used but available)
// ============================================================================
// ============================================================================
//  HELPER: draw_mode_sel — clickable mode selector (5 options)
// ============================================================================
// ============================================================================
//  LAYOUT
// ============================================================================
margin = floor(8 * S);
gap = floor(6 * S);
bar_h = floor(18 * S);
bar_sp = floor(21 * S);
col_w = 220;
pad = floor(4 * S);
pad2 = pad * 2;
gr_bar_h = max(2, floor(6 * S));
body_y = floor(50 * S);

// ============================================================================
//  LOGO + TITLE
// ============================================================================
gfx_getimgdim(0, logo_img_w, logo_img_h);
logo_img_w > 0 ? (
  logo_h = floor(32 * S);
  logo_w = floor(logo_h * (logo_img_w / logo_img_h));
  logo_x = floor(6 * S);
  logo_y = floor(((hdr_h - logo_h)) / 2);
  gfx_blit(0, 1, 0, 0, 0, logo_img_w, logo_img_h, logo_x, logo_y, logo_w, logo_h);
) : (
  logo_w = 0;
  logo_x = 0;
);
gfx_r = COL_TITLE_R; gfx_g = COL_TITLE_G; gfx_b = COL_TITLE_B;
gfx_setfont(1, "Arial", F_TITLE);
gfx_x = logo_x + logo_w + floor(8 * S); gfx_y = floor(10 * S);
gfx_drawstr("LMS TUBE SATURATOR");

// ============================================================================
//  LEFT COLUMN: CONTROLS
// ============================================================================
c1x = margin;
lms_draw_panel(c1x, body_y, col_w, floor(222 * S), "SATURATION");
cy = body_y + floor(26 * S);
_old = slider1; slider1 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider1, 0, 100, "Drive", 1);
slider1 != _old ? slider_automate(2^0);
cy += bar_sp;
_old = slider6; slider6 = lms_draw_mode_sel5(c1x + pad, cy, col_w - pad2, bar_h, slider6, 4, "Mode", "Warm Tube", "Hot Tube", "Tape", "Rectifier", "Fuzz");
slider6 != _old ? slider_automate(2^5);
cy += bar_sp;
_old = slider4; slider4 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider4, 0, 100, "Even Harm", 1);
slider4 != _old ? slider_automate(2^3);
cy += bar_sp;
_old = slider5; slider5 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider5, 0, 100, "Odd Harm", 1);
slider5 != _old ? slider_automate(2^4);
cy += bar_sp;
_old = slider8; slider8 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider8, 0, 100, "Bias", 1);
slider8 != _old ? slider_automate(2^7);
cy += bar_sp;
_old = slider7; slider7 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider7, 20, 20000, "Tone Hz", 1);
slider7 != _old ? slider_automate(2^6);
cy += bar_sp;
_old = slider2; slider2 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider2, -12, 12, "Output dB", 1);
slider2 != _old ? slider_automate(2^1);
cy += bar_sp;
_old = slider3; slider3 = draw_bar(c1x + pad, cy, col_w - pad2, bar_h, slider3, 0, 100, "Dry/Wet", 1);
slider3 != _old ? slider_automate(2^2);

// ============================================================================
//  RIGHT PANEL: TRANSFER CURVE
// ============================================================================
tc_x = margin + col_w + gap;
tc_w = gfx_w - tc_x - margin;
tc_h = 222;
lms_draw_panel(tc_x, body_y, tc_w, tc_h, "TRANSFER CURVE");

// Transfer curve box area
center_x = tc_x + tc_w / 2;
center_y = body_y + 22 + (tc_h - 22) / 2;
box_w = tc_w - 20;
box_h = tc_h - 36;

// Box background
gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.08;
gfx_rect(center_x - box_w/2, center_y - box_h/2, box_w, box_h);

// Center lines
gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.20;
gfx_line(center_x - box_w/2, center_y, center_x + box_w/2, center_y);
gfx_line(center_x, center_y - box_h/2, center_x, center_y + box_h/2);

// Linear reference (diagonal)
gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.25;
gfx_line(center_x - box_w/2, center_y + box_h/2,
         center_x + box_w/2, center_y - box_h/2);

// Draw the actual transfer curve
gfx_r = COL_ACCENT_R; gfx_g = COL_ACCENT_G; gfx_b = COL_ACCENT_B;
i = 0;
loop(100,
  // Input from -1 to 1
  in = (i / 99) * 2 - 1;

  // Show static transfer curve (tanh-based approximation for display only)
  mode == 0 ? out = lms_tanh(in * (1 + drive) * 1.2) * 0.85;
  mode == 1 ? out = lms_tanh(in * (1 + drive * 2) * 1.8) * 0.75;
  mode == 2 ? out = lms_tanh(in * (1 + drive * 1.5) * 0.8) * 0.95;
  mode == 3 ? out = lms_tanh(in * (1 + drive * 3) * 2.0) * 0.70;
  mode == 4 ? out = lms_tanh(in * (1 + drive * 4) * 2.5) * 0.60;

  out = max(-1, min(1, out));

  px = center_x + in * box_w * 0.5;
  py = center_y - out * box_h * 0.5;

  i == 0 ? (
    gfx_x = px; gfx_y = py;
  ) : (
    gfx_lineto(px, py);
  );

  i += 1;
);

  last_cap = mouse_cap;

  // --- BUY + NOTICE BUTTONS ---
  lms_gfx_chrome(gfx_h - floor(20 * S));

// ============================================================
// @SERIALIZE — Persist follow state
// ============================================================
@serialize
file_var(0, bc.bc_ser_compat_1);
file_var(0, bc.bc_ser_compat_2);
